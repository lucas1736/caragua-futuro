DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql
DB_NAME=caragua_futuro

PORT=3001
NODE_ENV=development
# Em produção, use uma chave aleatória com pelo menos 32 caracteres.
JWT_SECRET=coloque-uma-frase-longa-e-aleatoria-aqui

# Lista de origens frontend separadas por vírgula. Em produção, informe o domínio real.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Limite do corpo JSON; deve acomodar a foto de perfil redimensionada.
JSON_BODY_LIMIT=2mb

# E-mail de suporte exibido na página pública /suporte
VITE_SUPORTE_EMAIL=
